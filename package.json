{
  "name": "dsh-sandbox-mxc",
  "version": "0.1.0",
  "author": "dsh-sandbox-mxc-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitsmug/dsh-sandbox-mxc.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "DeepSeek Harness sandbox provider backed by MXC (Microsoft eXecution Containers): wraps ctx.sandbox.confine() argv as `wxc-exec --config-base64 <policy> -- <command>` on the BaseContainer backend. One runtime dependency (@microsoft/mxc-sdk, for the wxc-exec executable), no kernel patch.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-sandbox": "^0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@microsoft/mxc-sdk": "^1.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-sandbox": "^0.2.0-rc.2"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sandbox",
    "mxc",
    "processcontainer",
    "windows"
  ]
}
